%% =========================
%% DOMAIN
%% =========================

class Reservation {
  +reservationId: UUID
  +customerName: String
  +contactNumber: String
  +partySize: int
  +timeSlot: TimeSlot
  +status: ReservationStatus
  +tableId: UUID
  +notes: String
  +extend(newSlot: TimeSlot) void
  +cancel() void
  +checkIn() void
  +markNoShow() void
  +isActive() bool
}

class RestaurantTable {
  +tableId: UUID
  +tableNumber: String
  +capacity: int
  +status: TableStatus
  +zone: String
  +canFit(partySize: int) bool
  +markAvailable() void
  +markReserved() void
  +markOccupied() void
  +markOutOfOrder() void
}

class DiningSession {
  +sessionId: UUID
  +tableId: UUID
  +reservationId: UUID
  +startedAt: DateTime
  +expectedEndAt: DateTime
  +actualEndAt: DateTime
  +status: DiningSessionStatus
  +billingStatus: TableBillingStatus
  +extend(newExpectedEndAt: DateTime) void
  +finish() void
  +getRemainingTime(currentTime: DateTime) Duration
}

class TimeSlot {
  +start: DateTime
  +end: DateTime
  +overlaps(other: TimeSlot) bool
  +extendTo(newEnd: DateTime) TimeSlot
}

class ReservationStatus {
  PENDING
  CONFIRMED
  ARRIVED
  CANCELLED
  NO_SHOW
  COMPLETED
}

class TableStatus {
  FREE
  RESERVED
  OCCUPIED
  OUT_OF_ORDER
}

class DiningSessionStatus {
  ACTIVE
  EXTENDED
  FINISHED
}

class TableBillingStatus {
  NOT_READY
  READY_TO_PAY
  PAID
}

%% =========================
%% DTOs
%% =========================

class CreateReservationDto {
  +customerName: String
  +contactNumber: String
  +partySize: int
  +startTime: DateTime
  +endTime: DateTime
  +notes: String
}

class ExtendReservationDto {
  +newEndTime: DateTime
}

class ReservationCalendarQueryDto {
  +startDate: DateTime
  +endDate: DateTime
}

class FindAvailableTablesDto {
  +partySize: int
  +startTime: DateTime
  +endTime: DateTime
}

class GetWaitTimeDto {
  +partySize: int
}

class StartDiningSessionDto {
  +tableId: UUID
  +reservationId: UUID
  +expectedEndAt: DateTime
}

class ExtendDiningSessionDto {
  +newExpectedEndAt: DateTime
}

class ReservationResponseDto {
  +reservationId: UUID
  +customerName: String
  +partySize: int
  +startTime: DateTime
  +endTime: DateTime
  +status: ReservationStatus
  +tableNumber: String
}

class TableResponseDto {
  +tableId: UUID
  +tableNumber: String
  +capacity: int
  +status: TableStatus
  +zone: String
}

class DiningSessionResponseDto {
  +sessionId: UUID
  +tableId: UUID
  +tableNumber: String
  +startedAt: DateTime
  +expectedEndAt: DateTime
  +remainingMinutes: int
  +status: DiningSessionStatus
  +billingStatus: TableBillingStatus
}

class WaitTimeResponseDto {
  +estimatedMinutes: int
}

class ServiceTimeResponseDto {
  +remainingMinutes: int
  +isOvertime: bool
}

