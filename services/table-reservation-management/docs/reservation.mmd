%% =========================
%% DOMAIN SERVICES / STRATEGIES / COORDINATORS / MAPPERS
%% =========================

class ReservationValidator {
  +validateCreate(dto: CreateReservationDto) void
  +validateExtension(reservation: Reservation, newSlot: TimeSlot) void
  +validateCancellation(reservation: Reservation) void
  +validateCheckIn(reservation: Reservation) void
}

class AvailabilityChecker {
  +findAvailableTables(timeSlot: TimeSlot, partySize: int, reservations: Reservation[*], tables: RestaurantTable[*]) RestaurantTable[*]
  +isTableAvailable(table: RestaurantTable, timeSlot: TimeSlot, reservations: Reservation[*]) bool
}

class WaitTimeEstimator {
  +estimate(partySize: int, currentTime: DateTime, reservations: Reservation[*], sessions: DiningSession[*], tables: RestaurantTable[*]) Duration
}

class ServiceTimeTracker {
  +calculateRemaining(session: DiningSession, currentTime: DateTime) Duration
  +isOvertime(session: DiningSession, currentTime: DateTime) bool
}

class ITableAssignmentStrategy {
  +selectTable(candidateTables: RestaurantTable[*], partySize: int) RestaurantTable
}

class BestFitTableAssignmentStrategy {
  +selectTable(candidateTables: RestaurantTable[*], partySize: int) RestaurantTable
}

class ReservationCheckInCoordinator {
  -reservationRepo: IReservationRepository
  -tableRepo: ITableRepository
  -sessionRepo: IDiningSessionRepository
  -eventPublisher: IReservationEventPublisher
  +checkIn(reservationId: UUID) DiningSession
}

class ReservationMapper {
  +toResponseDto(reservation: Reservation, table: RestaurantTable) ReservationResponseDto
}

class TableMapper {
  +toResponseDto(table: RestaurantTable) TableResponseDto
}

class DiningSessionMapper {
  +toResponseDto(session: DiningSession, table: RestaurantTable) DiningSessionResponseDto
}

%% =========================
%% OUTBOUND PORTS
%% =========================

class IReservationRepository {
  +save(reservation: Reservation) Reservation
  +findById(id: UUID) Reservation
  +findOverlapping(timeSlot: TimeSlot) Reservation[*]
  +findByDateRange(start: DateTime, end: DateTime) Reservation[*]
}

class ITableRepository {
  +save(table: RestaurantTable) RestaurantTable
  +findById(id: UUID) RestaurantTable
  +findAll() RestaurantTable[*]
  +findByMinimumCapacity(capacity: int) RestaurantTable[*]
}

class IDiningSessionRepository {
  +save(session: DiningSession) DiningSession
  +findById(id: UUID) DiningSession
  +findActiveByTableId(tableId: UUID) DiningSession
  +findActiveSessions() DiningSession[*]
}

class IReservationEventPublisher {
  +publishCreated(reservation: Reservation) void
  +publishExtended(reservation: Reservation) void
  +publishCancelled(reservation: Reservation) void
  +publishCheckedIn(reservation: Reservation) void
  +publishNoShow(reservation: Reservation) void
}

class ITableStateEventPublisher {
  +publishTableAvailable(table: RestaurantTable) void
  +publishTableReserved(table: RestaurantTable) void
  +publishTableOccupied(table: RestaurantTable) void
  +publishTableOutOfOrder(table: RestaurantTable) void
}

class IDiningSessionEventPublisher {
  +publishSessionStarted(session: DiningSession) void
  +publishSessionExtended(session: DiningSession) void
  +publishSessionFinished(session: DiningSession) void
}

